# Copy to infra/.env (git-ignored) and fill in. Generate secrets with:
#   python -c "import secrets; print(secrets.token_hex(32))"

# Database password (internal network only, but still not a default).
POSTGRES_PASSWORD=

# HMAC key for de-identifying IPs and passwords. 64 hex chars.
# All deployments must use the SAME key, or pseudonyms will not match
# across them. Never commit it, never put it in a data release.
VULNMAZE_DEID_KEY=


# Where the honeypot's SSH port is published on the host.
# Dev: 127.0.0.1:2222   Public sensor: 0.0.0.0:22
SSH_PUBLISH=127.0.0.1:2222

# ---- LLM gap-filler ------------------------------------------------------
# Shared secret between Cowrie and the LLM gateway (>= 16 chars).
VULNMAZE_GATEWAY_TOKEN=

# Escalation: off = deterministic answers only. all = every eligible
# command goes to the gateway. learned = the classifiers decide per session
# and plant bait; needs infra/classifiers/session_models.joblib.
VULNMAZE_ESCALATION=off

# Model server. Defaults: Ollama in the stack, JSON mode.
VULNMAZE_LLM_BACKEND=ollama
VULNMAZE_LLM_URL=http://ollama:11434
VULNMAZE_LLM_MODEL=qwen3.5:4b
VULNMAZE_LLM_THINK=false
VULNMAZE_LLM_MODE=json
VULNMAZE_LLM_DEADLINE_S=15
VULNMAZE_LLM_CONCURRENCY=2

# Pin the Ollama image to the version you tested with (>= 0.5 for
# JSON-schema outputs).
OLLAMA_TAG=0.40.3

# OpenRouter (optional, for development only). Off by default: these lines are
# read only when you start the stack with -f infra/docker-compose.openrouter.yml.
# To allow OpenRouter, uncomment both lines and enter your key and a model id.
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=qwen/qwen3.5-9b
